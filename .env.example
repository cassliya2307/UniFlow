# Database
# Local/dev: file:./dev.db
# Docker Compose: file:/app/server/prisma/dev.db
# Railway (with Volume mounted at /data): file:/data/dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret - must be at least 32 chars, production fails without it
# Generate: openssl rand -base64 48  |  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace_with_a_random_32_character_secret

# Server
PORT=3000
NODE_ENV=development

# Client URL for CORS (comma-separated for multiple origins)
# Local dev: http://localhost:5173
# Docker Compose: http://localhost:3000
# Railway: https://<your-app>.up.railway.app
CLIENT_URL=http://localhost:5173

# Uploads
# Local/dev: ./uploads
# Docker Compose: /app/uploads
# Railway (with Volume mounted at /data): /data/uploads
UPLOAD_DIR=./uploads
MAX_FILES=5
